# CivicFlow Environment Configuration Example
# Copy to .env in backend/ or frontend/ as appropriate

# Backend Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./civicflow.db
DEBUG=True

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# AI Engine / Multimodal Vision (Optional: for cloud vision models)
MUNICIPAL_GATEWAY_MODE=SIMULATED
